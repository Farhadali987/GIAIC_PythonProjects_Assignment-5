[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = FarhadGul
	email = your_actual_github_email@example.com
[core]
	editor = \"D:\\Microsoft VS Code\\bin\\code\" --wait
	autocrlf = true
[credential "https://huggingface.co"]
	provider = generic
